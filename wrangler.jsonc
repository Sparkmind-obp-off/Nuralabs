{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuralabs",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "NURALABS_DB",
      "database_id": "LOCAL_DATABASE_ID"
    }
  ]
}
