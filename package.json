{
  "name": "nuralabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=NURALABS_DB --local --ip 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply NURALABS_DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply NURALABS_DB --remote"
  },
  "dependencies": {
    "e2b": "^2.49.1",
    "hono": "^4.9.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^9.35.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "wrangler": "^4.34.0"
  }
}
